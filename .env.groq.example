# Groq API Configuration
# Copy this file to .env and fill in your Groq API key

# Required: Your Groq API key (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Model selection (default: llama-3.3-70b-versatile)
# Available models:
#   - llama-3.3-70b-versatile (recommended for code generation)
#   - llama-3.1-70b-versatile
#   - mixtral-8x7b-32768
#   - gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Enable debug output
TESTGEN_DEBUG=1

# Optional: Test generation configuration
TESTGEN_OUTPUT_DIR=tests/generated
TESTGEN_MAX_RETRIES=3
TESTGEN_TIMEOUT=300

# Optional: Coverage configuration
MIN_COVERAGE_THRESHOLD=90

# Optional: SonarQube configuration (if using)
# SONAR_HOST_URL=http://localhost:9000
# SONAR_TOKEN=your_sonar_token
# SONAR_PROJECT_KEY=your_project_key
